# ─────────────────────────────────────────────────────────────────────────────
# DCK Agentic — production .env (VM deployment)
#
# The production deploy script creates this file and generates its passwords.
# For manual setup, fill in required values and run `chmod 600 .env`. Set
# DOCKER_GID from `stat -c '%g' /var/run/docker.sock`; the deploy script does it.
# Consumed by docker-compose.yml. Never commit real values.
#
#   cp .env.production.sample /opt/dck-agentic/.env
#   chmod 600 /opt/dck-agentic/.env
# ─────────────────────────────────────────────────────────────────────────────

# Image to run. CI publishes the image named `dck-agentic` under your GitHub
# owner's GHCR namespace, i.e. ghcr.io/<owner>/dck-agentic. Set CANVAS_IMAGE to
# that full path (without tag) and CANVAS_IMAGE_TAG to the tag. CI tags each
# build `sha-<short>` (plus a branch tag). Pin production to a `sha-<short>`;
# the bootstrap sets this automatically to the bundle's own build SHA.
CANVAS_IMAGE=ghcr.io/dck-ai/dck-agentic
CANVAS_IMAGE_TAG=sha-REPLACE_ME
DOCKER_GID=

# Beszel Hub is proxied by nginx at this URL; the host port stays loopback-only.
BESZEL_APP_URL=https://agent.dckautoposting.com/beszel
BESZEL_PORT=8090
# Generated during first production bootstrap. The Hub uses this account to
# enable the permanent universal token; keep this .env file mode 600.
BESZEL_ADMIN_EMAIL=
BESZEL_ADMIN_PASSWORD=
# Optional public-key override. Otherwise the initializer fetches it from Hub
# and stores it in beszel-agent-data/public-key.
BESZEL_AGENT_KEY=
# Filled by the deployment script after the token initializer completes.
BESZEL_AGENT_TOKEN=

# ── Dedicated DCK Postgres (service `postgres`, internal to the dck network) ──
# These create the superuser role on first `pgdata` init. The same role is
# used by the agent to `CREATE DATABASE dck_<app>` for webgen apps.
POSTGRES_USER=dck
POSTGRES_PASSWORD=change-me-strong-password   # e.g. `openssl rand -base64 32`
POSTGRES_DB=dck_agentic

# ── Automation database URL (PostgreSQL-only; asyncpg driver required) ────────
# Host is the compose service name `postgres`, resolvable inside the network.
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
AUTOMATION_DB_URL=postgresql+asyncpg://dck:change-me-strong-password@postgres:5432/dck_agentic

# ── Public base URL (used for automation callbacks injected into sandboxes) ──
AUTOMATION_BASE_URL=https://agent.dckautoposting.com
