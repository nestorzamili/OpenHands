# i18n translation files make by script using `make build`
public/locales/**/*
src/i18n/declaration.ts
.env
.envrc
node_modules/
build/
logs/
/.tmp/live-e2e-state/
# Scratch space for local E2E runs. Ignore the whole directory: besides the
# mock-llm state dirs, the suite also drops an automation DB and an unignored
# `secrets.json` here, which should never be committable.
/.tmp/
dist/
__pycache__


/test-results/
/test-results-live/
/test-results-mock-llm/
/test-results-mock-llm-docker/
/.mock-llm-markers/
/playwright-report/
/playwright-report-live/
/playwright-report-mock-llm/
/playwright-report-mock-llm-docker/
/blob-report/
/playwright/.cache/
/.stryker-tmp/
/reports/
.react-router/
ralph/
.vercel
*.tgz

# Local runtime artifacts produced by static-server / agent-server runs.
# The repo's own workspace/ now holds tracked DCK module content (skills,
# AGENTS.md, module dirs), so ignore only the generated-at-runtime artifacts
# inside it rather than the whole tree.
workspace/*/.env
workspace/**/.env
workspace/**/node_modules/
workspace/**/.next/

# Generated per-module projects and artifacts (webgen apps, research reports,
# powerbi models, analytics scripts, dashboard scaffolds). Each project gets
# its own commits/repo, so generated content must never pollute this repo's
# history. Strategy: ignore everything under each module directory, then
# re-include the shared DCK infrastructure we DO track — the `.gitkeep`
# placeholders, the skills under workspace/.agents, and workspace/AGENTS.md.
workspace/*/**
!workspace/.agents/
!workspace/.agents/**
!workspace/*/.gitkeep
!workspace/AGENTS.md

build-fresh/

# Electron desktop build outputs
/dist-electron/
# Downloaded uv binary (populated by `npm run download-uv` before packaging)
/resources/bin/
# Downloaded Node.js distribution (populated by `npm run download-node` before packaging)
/resources/node/
# Per-arch runtime downloads for macOS universal builds (ELECTRON_ARCH=universal)
/resources/bin-*/
/resources/node-*/

# DCK deployment runtime (secrets + state, recreated by `docker compose`).
# On the VM all three live under /opt/dck-agentic/; mirrored here so a repo
# checkout used as the release dir never commits state. .env.production.sample
# is the committed template; the real .env is covered by the `.env` rule above.
/config/
/pgdata/
