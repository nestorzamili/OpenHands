[Unit]
Description=DCK WebGen typed lifecycle control service
After=network-online.target docker.service nginx.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/opt/dck-agentic/webgen-control.env
Environment=WEBGEN_WORKSPACE_ROOT=/opt/dck-agentic/workspace
Environment=WEBGEN_NGINX_DIR=/etc/nginx/dck-apps
Environment=WEBGEN_CANVAS_AUTH_URL=http://127.0.0.1:8012/api/workspaces
Environment=WEBGEN_CONTROL_KEY=/opt/dck-agentic/config/webgen-control.key
Environment=WEBGEN_CONTROL_PORT=8769
WorkingDirectory=/opt/dck-agentic
ExecStart=/opt/dck-agentic/webgen-control-venv/bin/python /opt/dck-agentic/services/webgen-control/webgen_control.py
Restart=on-failure
RestartSec=2
UMask=0077

# The service needs Docker's local API and narrowly scoped writable paths, but
# should otherwise see a read-only host filesystem and no private user data.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/dck-agentic/workspace/webgen /opt/dck-agentic/config /etc/nginx/dck-apps /var/log/nginx

[Install]
WantedBy=multi-user.target
